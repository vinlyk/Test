# ─────────────────────────────────────────────────────────────────
# CEO-Assist Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Microsoft Graph (Outlook, Calendar, OneNote, SharePoint)
MICROSOFT_CLIENT_ID=your_azure_app_client_id
MICROSOFT_CLIENT_SECRET=your_azure_app_client_secret
MICROSOFT_TENANT_ID=your_azure_tenant_id
# Scopes needed: Mail.Read, Calendars.ReadWrite, Notes.ReadWrite,
#                Sites.Read.All, User.Read, Contacts.Read

# Affinity CRM
AFFINITY_API_KEY=your_affinity_api_key
AFFINITY_BASE_URL=https://api.affinity.co

# Pitchbook (if you have API access)
PITCHBOOK_API_KEY=your_pitchbook_api_key
PITCHBOOK_BASE_URL=https://api.pitchbook.com

# Travel (Amadeus API - free tier available)
AMADEUS_API_KEY=your_amadeus_api_key
AMADEUS_API_SECRET=your_amadeus_api_secret
AMADEUS_BASE_URL=https://test.api.amadeus.com  # change to production URL for live

# App Settings
APP_SECRET_KEY=generate_a_random_32_char_secret_here
LOG_LEVEL=INFO
DATA_DIR=~/.ceo-assist/data
MAX_EMAIL_FETCH=20
MAX_CALENDAR_DAYS_AHEAD=30
